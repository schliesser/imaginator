# Normalize line endings.
* text=auto

# Exclude development/infrastructure paths from the Composer dist tarball
# (`composer install --prefer-dist`). Keeps the published package lean: only
# Classes/, Configuration/, Resources/, Documentation/, composer.json and the
# ext_* files ship to integrators.
/.Build/                export-ignore
/.ddev/                 export-ignore
/.github/               export-ignore
/.idea/                 export-ignore
/.playwright-mcp/       export-ignore
/Build/                 export-ignore
/Tests/                 export-ignore
/docs/                  export-ignore
/node_modules/          export-ignore
/test-results/          export-ignore
/playwright-report/     export-ignore
/var/                   export-ignore
/.editorconfig          export-ignore
/.gitattributes         export-ignore
/.gitignore             export-ignore
/.php-cs-fixer.cache    export-ignore
/.php-cs-fixer.dist.php  export-ignore
/package.json           export-ignore
/package-lock.json      export-ignore
/playwright.config.ts   export-ignore
/vitest.config.ts       export-ignore
