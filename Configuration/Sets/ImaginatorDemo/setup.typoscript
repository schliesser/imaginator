# Demo page rendering for manual testing of the <i:image> ViewHelper.
# Active only on sites that opt into the "schliesser/imaginator-demo" set.

# Demo only: let content-object exceptions bubble to the (debug) exception handler with a full
# stack trace instead of swallowing them as the generic "Oops, an error occurred!" placeholder.
# Pairs with SYS/displayErrors=1 + devIPmask=* in config/system/settings.php. Never ship this on
# a production site — a thrown ViewHelper would then leak internals to visitors.
config.contentObjectExceptionHandler = 0

page = PAGE
page.10 = FLUIDTEMPLATE
page.10 {
    templateName = Home
    templateRootPaths.0 = EXT:imaginator/Resources/Private/Demo/Templates/

    # Load this page's content elements + their FAL image references (with editor crop) so the
    # template can render them through <i:image image="{ref}"> (the r{referenceUid} path).
    dataProcessing {
        10 = TYPO3\CMS\Frontend\DataProcessing\DatabaseQueryProcessor
        10 {
            table = tt_content
            pidInList.field = uid
            where = colPos = 0 AND CType = 'textmedia'
            orderBy = sorting
            as = contentElements
            dataProcessing {
                10 = TYPO3\CMS\Frontend\DataProcessing\FilesProcessor
                10 {
                    references.fieldName = assets
                    as = media
                }
                # Resolve the per-CE per-breakpoint aspect ratios (tx_imaginator_aspect_ratios JSON)
                # into a BreakpointRatio[] the template feeds to every <i:image breakpoints="...">.
                20 = Schliesser\Imaginator\DataProcessing\AspectRatioProcessor
                20 {
                    as = imaginatorAspectRatios
                }
            }
        }
    }
}
