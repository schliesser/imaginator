<?xml version="1.0" encoding="UTF-8"?>
<guides
    xmlns="https://www.phpdoc.org/guides"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://www.phpdoc.org/guides vendor/phpdocumentor/guides-cli/resources/schema/guides.xsd"
    theme="typo3docs"
    default-code-language="php"
    links-are-relative="true"
>
    <project
        title="Imaginator"
        version="0.0"
        release="0.0.1"
        copyright="since 2026 by André Buchmann"
    />

    <extension
        class="\T3Docs\Typo3DocsTheme\DependencyInjection\Typo3DocsThemeExtension"
        typo3-core-preferred="stable"
        interlink-shortcode="schliesser/imaginator"
        project-home="https://extensions.typo3.org/extension/imaginator"
        project-contact="https://github.com/schliesser/imaginator/issues"
        project-repository="https://github.com/schliesser/imaginator"
        project-issues="https://github.com/schliesser/imaginator/issues"
        edit-on-github="schliesser/imaginator"
        edit-on-github-branch="main"
        edit-on-github-directory="Documentation"
    />

    <inventory id="t3coreapi" url="https://docs.typo3.org/m/typo3/reference-coreapi/main/en-us/"/>
    <inventory id="t3tca" url="https://docs.typo3.org/m/typo3/reference-tca/main/en-us/"/>
    <inventory id="t3tsref" url="https://docs.typo3.org/m/typo3/reference-typoscript/main/en-us/"/>
    <inventory id="h2document" url="https://docs.typo3.org/m/typo3/docs-how-to-document/main/en-us/"/>
</guides>
