{
    "name": "schliesser/imaginator",
    "type": "typo3-cms-extension",
    "description": "Imaginator - Zero-config responsive images for TYPO3: signed srcset ladders, local or external processing.",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-frontend": "^13.4 || ^14.3",
        "typo3/cms-fluid": "^13.4 || ^14.3",
        "srwiez/thumbhash": "^1.5"
    },
    "conflict": {
        "zeroseven/pictureino": "*"
    },
    "require-dev": {
        "typo3/testing-framework": "^8.2 || ^9.0",
        "phpunit/phpunit": "^11.0",
        "friendsofphp/php-cs-fixer": "^3.51",
        "phpstan/phpstan": "^2.1",
        "typo3/cms-install": "^13.4 || ^14.3",
        "typo3/cms-setup": "^13.4 || ^14.3",
        "typo3/cms-fluid-styled-content": "^13.4 || ^14.3",
        "typo3/cms-tstemplate": "^13.4 || ^14.3",
        "typo3/cms-lowlevel": "^13.4 || ^14.3",
        "typo3/cms-filelist": "^13.4 || ^14.3",
        "typo3/cms-extensionmanager": "^13.4 || ^14.3",
        "typo3/cms-belog": "^13.4 || ^14.3",
        "typo3/cms-beuser": "^13.4 || ^14.3",
        "typo3/cms-info": "^13.4 || ^14.3",
        "saschaegerer/phpstan-typo3": "^3.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-phpunit": "^2.0",
        "friendsoftypo3/content-blocks": "^1.6 || ^2.4"
    },
    "autoload": {
        "psr-4": {
            "Schliesser\\Imaginator\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Schliesser\\Imaginator\\Tests\\": "Tests/",
            "Schliesser\\ImaginatorFixture\\AttributeProcessor\\": "Tests/Functional/Fixtures/Extensions/attribute_processor/Classes/"
        }
    },
    "config": {
        "vendor-dir": ".Build/vendor",
        "bin-dir": ".Build/bin",
        "allow-plugins": {
            "typo3/cms-composer-installers": true,
            "typo3/class-alias-loader": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "imaginator",
            "version": "1.0.0",
            "web-dir": ".Build/public",
            "Package": {
                "providesPackages": {}
            }
        }
    }
}
